# Lanthorn — Token Juice profile (template).
#
# No credential ships in this repository: a key committed to a public repo is
# a budget anyone can spend. The token below is empty on purpose, and an empty
# token is what makes /source-tokenjuice name its setup step instead of
# sending nothing upstream and reporting the 401 as if the account broke.
#
# Set your own key with `/source-tokenjuice <tj_ key>`, which writes it to
# ~/.lanthorn/tokenjuice/source (mode 600). That file is read before this one,
# so your key never touches the repository. Get one at https://tokenjuice.ai
#
# Token Juice serves Chat Completions itself, so there is no proxy on this
# route: the URL below is the upstream, not a localhost port.

export ANTHROPIC_BASE_URL="https://api.tokenjuice.ai/v1"
export ANTHROPIC_AUTH_TOKEN=""
# The id the upstream serves. The snapshot suffix rotates; /source-tokenjuice
# re-reads the live catalog on every switch and moves to the current one.
export ANTHROPIC_MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017"

# Load-bearing: an empty string keeps ANTHROPIC_AUTH_TOKEN authoritative and
# clears any real API key inherited from the shell.
export ANTHROPIC_API_KEY=""

# Token Juice serves exactly one chat model, so there is nothing to alias.
export MODEL_DEFAULT="deepseek-ai/DeepSeek-V4.1-Flash-1017"
